    "build": "vite build",
    "build:binary": "bun scripts/build-binary.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "doctor": "bun src/cli.ts doctor"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@tailwindcss/vite": "4.3.5",
    "cron-parser": "5.10.5",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.5",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun": "1.4.4",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
