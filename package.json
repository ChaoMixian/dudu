{
  "name": "dudu",
  "version": "0.1.0",
  "description": "Local-first Bot workbench with persistent identities, memory, and per-Bot Linux desktops.",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun src/server.ts",
    "cli": "bun src/cli.ts",
    "test": "bun test",
